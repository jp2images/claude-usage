<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plain net8.0 (NOT net8.0-windows) is what makes this build unchanged on
         macOS, Windows and Linux. OS differences are handled at runtime. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ClaudeUsage</AssemblyName>
    <RootNamespace>ClaudeUsage</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Windows .exe icon. Generated from ../../ClaudeUsage.icon by
         scripts/build-icons.sh; ignored when the build host isn't Windows. -->
    <ApplicationIcon>Assets/ClaudeUsage.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file again, as an Avalonia resource, for the window/taskbar icon. -->
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests drive the transcript accumulator directly, below the
         disk-cached Load() entry point. -->
    <InternalsVisibleTo Include="ClaudeUsage.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <!-- Cross-platform; DPAPI calls are Windows-guarded at runtime. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.6" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
